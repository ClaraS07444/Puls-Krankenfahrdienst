---
import TopicPage from "../../layouts/TopicPage.astro";
import { services, type Topic } from "../../data/site";

export function getStaticPaths() {
  return services.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props as { topic: Topic };
---

<TopicPage topic={topic} section={{ label: "Leistungen", href: "/leistungen/" }} siblings={services} />
