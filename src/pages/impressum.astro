---
import LegalPage from "../layouts/LegalPage.astro";
import { agency, company, owner } from "../data/site";
---

<LegalPage title="Impressum" description="Impressum – Angaben gemäß § 5 DDG.">
  <p class="notice notice-dark">
    Diese Website ist ein Konzeptprojekt von <a href={agency.url} rel="noopener">{agency.name}</a>. {company.name} ist ein fiktives
    Unternehmen.
  </p>

  <h2>Angaben gemäß § 5 DDG</h2>
  <p>
    {owner.name}<br />
    {owner.street}<br />
    {owner.zip} {owner.city}
  </p>

  <h3>Kontakt</h3>
  <p>E-Mail: <a href={`mailto:${owner.email}`}>{owner.email}</a></p>

  <h3>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h3>
  <p>{owner.name}, Anschrift wie oben</p>

  <h3>Hinweis zu den Inhalten</h3>
  <p>
    Alle Angaben zu {company.name} – Standorte, Fahrzeuge, Personen, Kennzahlen und Konditionen – sind frei erfunden und dienen
    ausschließlich der Präsentation des Designs. Über diese Website können keine Fahrten gebucht werden; Formulareingaben werden nicht
    übermittelt.
  </p>
</LegalPage>
