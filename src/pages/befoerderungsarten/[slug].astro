---
import TopicPage from "../../layouts/TopicPage.astro";
import { transportTypes, type Topic } from "../../data/site";

export function getStaticPaths() {
  return transportTypes.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props as { topic: Topic };
---

<TopicPage topic={topic} section={{ label: "Beförderungsarten", href: "/befoerderungsarten/" }} siblings={transportTypes} />
