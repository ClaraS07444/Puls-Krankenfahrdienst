---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { agency, company, locations } from "../data/site";
---

<Base
  title="Kontakt"
  description="Kontakt zu PULS Krankenfahrdienst: Standorte in Aachen, Köln und Frankfurt am Main, Erreichbarkeit der Disposition und Online-Anfrage."
>
  <PageHero
    eyebrow="Kontakt"
    title="Wir sind für Sie da"
    lead="Für planbare Fahrten schreiben Sie uns am einfachsten über das Online-Formular. Wir prüfen Ihre Anfrage und melden uns mit einer Bestätigung."
  >
    <div class="button-row fly-in" style="--d: 3">
      <a class="btn" href="/fahrt-anfragen/">Fahrt online anfragen</a>
      <a class="btn btn-outline" href="/faq/">Häufige Fragen</a>
    </div>
  </PageHero>

  <section class="section section-ink">
    <div class="container grid grid-3">
      {
        locations.map((l, i) => (
          <article class="card card-dark location-card reveal" style={`--d: ${i}`}>
            <span class="role">{l.role}</span>
            <h2>{company.name} {l.city}</h2>
            <p>{l.region}</p>
            <p><a class="text-link" href={`/standorte/${l.slug}/`}>Einsatzgebiet ansehen →</a></p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container split top">
      <div class="reveal" data-reveal="left">
        <h2>Erreichbarkeit der Disposition</h2>
        <dl class="hours">
          {company.dispatchHours.map((h) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
        </dl>
        <p class="muted">
          Diese Website ist ein Konzeptprojekt von <a class="text-link" href={agency.url} rel="noopener">{agency.name}</a>. {company.name} ist
          ein fiktives Unternehmen – Anfragen werden nicht übermittelt. Kontakt zum Projekt finden Sie im
          <a class="text-link" href="/impressum/">Impressum</a>.
        </p>
      </div>
      <aside class="notice notice-dark reveal" data-reveal="right">
        <strong>Kein Notfalldienst</strong>
        <p class="muted">
          Bei akuten medizinischen Notfällen wählen Sie bitte <strong>112</strong>. Den ärztlichen Bereitschaftsdienst erreichen Sie unter
          <strong>116 117</strong>.
        </p>
      </aside>
    </div>
  </section>
</Base>
