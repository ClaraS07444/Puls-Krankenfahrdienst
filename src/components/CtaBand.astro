---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Fahrt planen? Wir sind für Sie da.",
  text = "Schicken Sie uns Ihre Anfrage online. Wir prüfen sie und melden uns mit einer Bestätigung.",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="container cta-inner reveal" data-reveal="zoom">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="button-row">
      <a class="btn btn-light" href="/fahrt-anfragen/">Online anfragen</a>
      <a class="btn btn-outline" href="/faq/">Häufige Fragen</a>
    </div>
  </div>
</section>
